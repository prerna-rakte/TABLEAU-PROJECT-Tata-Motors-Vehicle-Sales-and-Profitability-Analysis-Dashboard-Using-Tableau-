      <column caption='Total Sales' datatype='integer' name='[Calculation_1047336670330880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue])' />
      </column>
      <column caption='Estimated Profit' datatype='real' name='[Calculation_1047336670400513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue] * [Profit Margin (%)] / 100)' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1047336670482434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue] * [Profit Margin (%)] / 100) / SUM([Revenue])' />
      </column>
      <column caption='Average Sales' datatype='real' name='[Calculation_1047336670547971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Revenue])' />
