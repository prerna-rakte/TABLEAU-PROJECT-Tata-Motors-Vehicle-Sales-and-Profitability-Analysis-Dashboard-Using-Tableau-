    <worksheet name='KPI - Estimated Profit'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='8'>Estimated Profit</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Tata_sales_data' name='federated.1ix1cow1cmynvz105l2mr0s8ira4' />
          </datasources>
          <datasource-dependencies datasource='federated.1ix1cow1cmynvz105l2mr0s8ira4'>
            <column caption='Estimated Profit' datatype='real' name='[Calculation_1047336670400513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Revenue] * [Profit Margin (%)] / 100)' />
